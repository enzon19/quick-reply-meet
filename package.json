{
	"name": "quick-reply-meet",
	"description": "Send messages in Google Meet chat without typing.",
	"author": {
		"name": "enzon19",
		"email": "contato@enzon19.com",
		"url": "https://enzon19.com"
	},
	"type": "module",
	"version": "2.0.0",
	"private": true,
	"scripts": {
    "build:icons": "bun scripts/generate-icons.ts",
		"dev": "bun run build:icons && wxt",
		"dev:firefox": "bun run build:icons && wxt -b firefox",
		"build": "bun run build:icons && wxt build",
		"build:firefox": "bun run build:icons && wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"m3-svelte": "^7.0.1",
		"svelte-dnd-action": "^0.9.69",
		"svelte-tiny-slider": "^2.4.1",
		"vite-plugin-functions-mixins": "^0.4.1"
	},
	"devDependencies": {
		"@iconify-json/material-symbols": "^1.2.50",
		"@iconify/utils": "^3.1.0",
		"@tsconfig/svelte": "^5.0.6",
		"@wxt-dev/module-svelte": "^2.0.4",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.46.0",
		"svelte-check": "^4.3.4",
		"svooltip": "^0.9.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"wxt": "^0.20.6"
	}
}
